<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EventFlow</title><style>
*{box-sizing:border-box}body{margin:0;font:15px system-ui,sans-serif;color:#37352f;background:#fff}aside{width:235px;background:#f7f7f5;position:fixed;inset:0 auto 0 0;padding:24px 14px;border-right:1px solid #eee}h1{font-size:34px;letter-spacing:-1.5px;margin:12px 0}h2{font-size:20px}button,input,select{font:inherit}button{cursor:pointer;border:1px solid #ddd;background:white;border-radius:6px;padding:9px 13px;color:inherit}button:hover{background:#efefeb}nav button{display:block;width:100%;text-align:left;border:0;background:transparent;margin:4px 0}nav button.active{background:#e8e8e3;font-weight:600}.brand{font-weight:750;font-size:20px;margin:0 8px 32px}.muted{color:#85847e;font-size:13px}main{margin-left:235px;padding:36px 6%;max-width:1500px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px}.primary{background:#37352f;color:white;border-color:#37352f}.primary:hover{background:#555}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:25px 0}.card{border:1px solid #e6e5e1;border-radius:9px;padding:20px}.number{font-size:30px;font-weight:650;margin-top:8px}.panel{border:1px solid #e6e5e1;border-radius:9px;margin:18px 0;overflow:auto}table{width:100%;border-collapse:collapse;text-align:left}td,th{padding:13px;border-bottom:1px solid #eee;white-space:nowrap}th{font-size:12px;color:#777;font-weight:500}tr:last-child td{border-bottom:0}.tag{background:#e7efe4;color:#42623d;padding:4px 9px;border-radius:5px;font-size:12px}.bar{height:6px;background:#eee;border-radius:9px;min-width:80px}.bar i{display:block;height:100%;background:#83a58b;border-radius:9px}dialog{border:1px solid #ddd;border-radius:12px;padding:25px;width:min(440px,92vw)}dialog::backdrop{background:#0005}label{display:block;margin:12px 0}input:not([type=checkbox]),select{display:block;width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;margin-top:5px}form .top{margin-top:20px}.rule{padding:16px;display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #eee}.empty{padding:20px;color:#888}.done{text-decoration:line-through;color:#999}.notice{background:#f9f4e8;padding:12px;border-radius:6px;margin:12px 0}@media(max-width:700px){aside{position:static;width:auto;padding:12px}.brand{margin:4px 0}nav{display:flex;overflow:auto}nav button{white-space:nowrap;width:auto}main{margin:0;padding:20px}.cards{grid-template-columns:1fr}.top{flex-wrap:wrap}}
</style></head><body><aside><div class="brand">◈ EventFlow</div><div class="muted">ESPACE DE TRAVAIL</div><nav id="nav"></nav><p class="muted">Prototype · stockage local</p></aside><main id="main"></main><dialog id="modal"></dialog><script>
const initial={events:[{id:1,name:'Festival Summer Live',date:'2027-06-12',budget:30000,spent:18500},{id:2,name:'Séminaire corporate',date:'2027-04-15',budget:12000,spent:4200}],tasks:[{id:3,event:1,name:'Valider les prestataires',date:'2027-03-01',done:false},{id:4,event:2,name:'Réserver le lieu',date:'2027-02-01',done:true}],rules:{checklist:true,budget:true,deadline:true}};let data;try{data=JSON.parse(localStorage.getItem('eventflow-v1'))||initial}catch{data=initial}let page='Accueil';const pages=['Accueil','Événements','Tâches','Budgets','Automatisations'];const icons=['⌂','▣','☑','€','⚡'];const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const euro=n=>Number(n).toLocaleString('fr-FR',{style:'currency',currency:'EUR',maximumFractionDigits:0});const date=s=>s?new Date(s+'T12:00:00').toLocaleDateString('fr-FR'):'—';const uid=()=>Date.now()+Math.floor(Math.random()*10000);function save(){try{localStorage.setItem('eventflow-v1',JSON.stringify(data))}catch{alert('Stockage local indisponible : les changements ne seront pas conservés.')}render()}function go(p){page=p;render()}function progress(e){let t=data.tasks.filter(t=>t.event===e.id);return t.length?Math.round(t.filter(t=>t.done).length/t.length*100):0}function events(){return `<div class="panel"><table><thead><tr><th>Événement</th><th>Date</th><th>Budget</th><th>Avancement</th><th></th></tr></thead><tbody>${data.events.map(e=>`<tr><td><b>${esc(e.name)}</b></td><td>${date(e.date)}</td><td>${euro(e.budget)}</td><td><div class="bar"><i style="width:${progress(e)}%"></i></div><small>${progress(e)} %</small></td><td><button onclick="editEvent(${e.id})">Modifier</button></td></tr>`).join('')}</tbody></table>${data.events.length?'':'<p class="empty">Aucun événement.</p>'}</div>`}function tasks(){return `<div class="panel"><table><thead><tr><th>Fait</th><th>Tâche</th><th>Événement</th><th>Échéance</th><th></th></tr></thead><tbody>${data.tasks.map(t=>`<tr><td><input aria-label="Tâche terminée" type="checkbox" ${t.done?'checked':''} onchange="toggleTask(${t.id})"></td><td class="${t.done?'done':''}">${esc(t.name)}</td><td>${esc(data.events.find(e=>e.id===t.event)?.name)}</td><td>${date(t.date)}</td><td><button onclick="removeTask(${t.id})">Supprimer</button></td></tr>`).join('')}</tbody></table></div>`}function render(){ $('nav').innerHTML=pages.map((p,i)=>`<button class="${p===page?'active':''}" onclick="go('${p}')">${icons[i]} &nbsp;${p}</button>`).join('');let html=`<div class="muted">EventFlow / ${page}</div><div class="top"><h1>${page==='Accueil'?'Mon espace événementiel':page}</h1>${['Accueil','Événements'].includes(page)?'<button class="primary" onclick="editEvent()">+ Nouvel événement</button>':page==='Tâches'?'<button class="primary" onclick="newTask()">+ Nouvelle tâche</button>':''}</div>`;if(page==='Accueil'){html+=`<p class="muted">Tous vos projets, au même endroit.</p><div class="cards">${[['Événements',data.events.length],['Tâches à faire',data.tasks.filter(t=>!t.done).length],['Budget total',euro(data.events.reduce((s,e)=>s+e.budget,0))]].map(([k,v])=>`<div class="card"><div class="muted">${k}</div><div class="number">${v}</div></div>`).join('')}</div>`;if(data.rules.budget)data.events.filter(e=>e.budget>0&&e.spent/e.budget>=.9).forEach(e=>html+=`<div class="notice">⚠ ${esc(e.name)} : 90 % du budget ou plus consommé.</div>`);if(data.rules.deadline)data.tasks.filter(t=>!t.done&&t.date&&new Date(t.date+'T23:59:59')<new Date()).forEach(t=>html+=`<div class="notice">⚠ Échéance dépassée : ${esc(t.name)}</div>`);html+='<h2>Mes événements</h2>'+events()+'<h2>Mes tâches</h2>'+tasks()}if(page==='Événements')html+=events();if(page==='Tâches')html+=tasks();if(page==='Budgets')html+=`<div class="panel"><table><tr><th>Événement</th><th>Prévisionnel</th><th>Dépensé</th><th>Restant</th><th></th></tr>${data.events.map(e=>`<tr><td>${esc(e.name)}</td><td>${euro(e.budget)}</td><td>${euro(e.spent)}</td><td>${euro(e.budget-e.spent)}</td><td><button onclick="editEvent(${e.id})">Modifier</button></td></tr>`).join('')}</table></div>`;if(page==='Automatisations')html+='<p class="muted">Règles locales exécutées dans ce prototype.</p><div class="panel">'+[['checklist','Générer une checklist','À la création d’un événement, ajouter quatre tâches types.'],['budget','Alerte budget','Afficher une alerte sur l’accueil à partir de 90 % du budget.'],['deadline','Alerte échéance','Afficher les tâches en retard sur l’accueil.']].map(([k,n,d])=>`<div class="rule"><div><b>${n}</b><p class="muted">${d}</p></div><input aria-label="${n}" type="checkbox" ${data.rules[k]?'checked':''} onchange="data.rules.${k}=this.checked;save()"></div>`).join('')+'</div>'; $('main').innerHTML=html}function toggleTask(id){let t=data.tasks.find(t=>t.id===id);t.done=!t.done;save()}function removeTask(id){data.tasks=data.tasks.filter(t=>t.id!==id);save()}function editEvent(id){let e=data.events.find(e=>e.id===id);$('modal').innerHTML=`<form id="eventForm"><h2>${e?'Modifier':'Créer'} un événement</h2><label>Nom<input name="name" required value="${esc(e?.name)}"></label><label>Date<input type="date" name="date" required value="${esc(e?.date)}"></label><label>Budget (€)<input type="number" min="0" step="0.01" name="budget" required value="${e?.budget??0}"></label><label>Dépenses (€)<input type="number" min="0" step="0.01" name="spent" required value="${e?.spent??0}"></label><div class="top"><button type="button" onclick="document.getElementById('modal').close()">Annuler</button><button class="primary">Enregistrer</button></div></form>`;$('eventForm').onsubmit=ev=>{ev.preventDefault();let f=new FormData(ev.target);let obj={id:e?.id??uid(),name:f.get('name'),date:f.get('date'),budget:+f.get('budget'),spent:+f.get('spent')};if(e)Object.assign(e,obj);else{data.events.push(obj);if(data.rules.checklist)[['Valider le brief',90],['Réserver le lieu',60],['Confirmer les prestataires',30],['Préparer le conducteur jour J',7]].forEach(([name,days])=>{let d=new Date(obj.date+'T12:00:00Z');d.setUTCDate(d.getUTCDate()-days);data.tasks.push({id:uid(),event:obj.id,name,date:d.toISOString().slice(0,10),done:false})})}$('modal').close();save()};$('modal').showModal()}function newTask(){if(!data.events.length){editEvent();return}$('modal').innerHTML=`<form id="taskForm"><h2>Nouvelle tâche</h2><label>Nom<input name="name" required></label><label>Événement<select name="event">${data.events.map(e=>`<option value="${e.id}">${esc(e.name)}</option>`).join('')}</select></label><label>Échéance<input name="date" type="date" required></label><div class="top"><button type="button" onclick="document.getElementById('modal').close()">Annuler</button><button class="primary">Créer</button></div></form>`;$('taskForm').onsubmit=ev=>{ev.preventDefault();let f=new FormData(ev.target);data.tasks.push({id:uid(),event:+f.get('event'),name:f.get('name'),date:f.get('date'),done:false});$('modal').close();save()};$('modal').showModal()}render();</script></body></html>

